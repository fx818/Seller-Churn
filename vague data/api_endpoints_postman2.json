{
  "info": {
    "name": "Call Personalisation — IndiaMART Internal APIs",
    "description": "All 11 endpoints used by call_personalisation/agent/data_sources/api_client.py.\n\nBefore running:\n1. Open the collection → Variables tab.\n2. Set: glid, empid, jwt (IM_INTERNAL_JWT), c2cid.\n3. Then run any request.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "glid",  "value": "REPLACE_WITH_GLID",  "description": "Seller GLID (numeric)" },
    { "key": "empid", "value": "REPLACE_WITH_EMPID", "description": "Your IM employee ID" },
    { "key": "jwt",   "value": "REPLACE_WITH_IM_INTERNAL_JWT", "description": "Bearer token (IM_INTERNAL_JWT). Also used as 'ak' in Context API body." },
    { "key": "c2cid", "value": "REPLACE_WITH_C2CID", "description": "Click-to-call ID from a DSR connect entry" },
    { "key": "ingestion_url", "value": "REPLACE_WITH_INGESTION_URL", "description": "Ingestion service base URL (no trailing slash)" },
    { "key": "ingestion_api_key", "value": "REPLACE_WITH_INGESTION_API_KEY", "description": "x-api-key for ingestion service" },
    { "key": "mapping_id", "value": "REPLACE_WITH_MAPPING_ID", "description": "UUID returned by generateContextUID (valid ~15 min)" },
    { "key": "as_of", "value": "2026-05-14", "description": "as_of date for /metrics (YYYY-MM-DD)" }
  ],
  "item": [
    {
      "name": "DWH POST",
      "item": [
        {
          "name": "mcat",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "text/plain" }],
            "body": {
              "mode": "raw",
              "raw": "{\"in_glusr_usr_id\":\"{{glid}}\",\"in_rpt_type\":\"1\"}"
            },
            "url": {
              "raw": "https://imdwh.intermesh.net/api/go/mcatLocDtls",
              "protocol": "https",
              "host": ["imdwh", "intermesh", "net"],
              "path": ["api", "go", "mcatLocDtls"]
            }
          }
        },
        {
          "name": "scorecard_summary",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "text/plain" }],
            "body": {
              "mode": "raw",
              "raw": "{\"in_glusr_usr_id\":\"{{glid}}\",\"in_rpt_type\":\"1\"}"
            },
            "url": {
              "raw": "https://imdwh.intermesh.net/api/go/cust_wh_summary_api",
              "protocol": "https",
              "host": ["imdwh", "intermesh", "net"],
              "path": ["api", "go", "cust_wh_summary_api"]
            }
          }
        },
        {
          "name": "scorecard_6m",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "text/plain" }],
            "body": {
              "mode": "raw",
              "raw": "{\"in_glusr_usr_id\":\"{{glid}}\",\"in_rpt_type\":\"1\"}"
            },
            "url": {
              "raw": "https://imdwh.intermesh.net/api/go/cust_scorecard_api",
              "protocol": "https",
              "host": ["imdwh", "intermesh", "net"],
              "path": ["api", "go", "cust_scorecard_api"]
            }
          }
        },
        {
          "name": "scorecard_12m",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "text/plain" }],
            "body": {
              "mode": "raw",
              "raw": "{\"in_glusr_usr_id\":\"{{glid}}\",\"in_rpt_type\":\"1\"}"
            },
            "url": {
              "raw": "https://imdwh.intermesh.net/api/go/cust_wh_apiv2",
              "protocol": "https",
              "host": ["imdwh", "intermesh", "net"],
              "path": ["api", "go", "cust_wh_apiv2"]
            }
          }
        }
      ]
    },
    {
      "name": "Competitors",
      "item": [
        {
          "name": "competitors (comp_flag=1)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "accept", "value": "application/json" },
              { "key": "Content-Type", "value": "body/raw" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"in_glusr_usr_id\":\"{{glid}}\",\"comp_flag\":\"1\"}"
            },
            "url": {
              "raw": "https://imdwh.intermesh.net/api/go/nsdprepplus?in_glusr_usr_id={{glid}}&comp_flag=1",
              "protocol": "https",
              "host": ["imdwh", "intermesh", "net"],
              "path": ["api", "go", "nsdprepplus"],
              "query": [
                { "key": "in_glusr_usr_id", "value": "{{glid}}" },
                { "key": "comp_flag", "value": "1" }
              ]
            }
          }
        },
        {
          "name": "competitors_counts (comp_flag=2)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "accept", "value": "application/json" },
              { "key": "Content-Type", "value": "body/raw" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"in_glusr_usr_id\":\"{{glid}}\",\"comp_flag\":\"2\"}"
            },
            "url": {
              "raw": "https://imdwh.intermesh.net/api/go/nsdprepplus?in_glusr_usr_id={{glid}}&comp_flag=2",
              "protocol": "https",
              "host": ["imdwh", "intermesh", "net"],
              "path": ["api", "go", "nsdprepplus"],
              "query": [
                { "key": "in_glusr_usr_id", "value": "{{glid}}" },
                { "key": "comp_flag", "value": "2" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "MERP GET",
      "item": [
        {
          "name": "history",
          "request": {
            "method": "GET",
            "header": [
              { "key": "accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt}}" }
            ],
            "url": {
              "raw": "https://merp.intermesh.net/index.php/Userlist/newHistory?glid={{glid}}&empid={{empid}}&tab=history&platform=VoiceEval&duration=7",
              "protocol": "https",
              "host": ["merp", "intermesh", "net"],
              "path": ["index.php", "Userlist", "newHistory"],
              "query": [
                { "key": "glid", "value": "{{glid}}" },
                { "key": "empid", "value": "{{empid}}" },
                { "key": "tab", "value": "history" },
                { "key": "platform", "value": "VoiceEval" },
                { "key": "duration", "value": "7" }
              ]
            }
          }
        },
        {
          "name": "dsr",
          "request": {
            "method": "GET",
            "header": [
              { "key": "accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt}}" }
            ],
            "url": {
              "raw": "https://merp.intermesh.net/bi/reports/dsr/glusrDSR?glid={{glid}}&empid={{empid}}&modid=WEBERP&screen_name=DSR",
              "protocol": "https",
              "host": ["merp", "intermesh", "net"],
              "path": ["bi", "reports", "dsr", "glusrDSR"],
              "query": [
                { "key": "glid", "value": "{{glid}}" },
                { "key": "empid", "value": "{{empid}}" },
                { "key": "modid", "value": "WEBERP" },
                { "key": "screen_name", "value": "DSR" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Product Quality",
      "item": [
        {
          "name": "product_summary",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt}}" }],
            "url": {
              "raw": "https://merp.intermesh.net/go/api/csd/v1/qualityScoreDetails?glid={{glid}}&empid={{empid}}&flag=summary",
              "protocol": "https",
              "host": ["merp", "intermesh", "net"],
              "path": ["go", "api", "csd", "v1", "qualityScoreDetails"],
              "query": [
                { "key": "glid", "value": "{{glid}}" },
                { "key": "empid", "value": "{{empid}}" },
                { "key": "flag", "value": "summary" }
              ]
            }
          }
        },
        {
          "name": "product_details (paginated — bump offset by 20)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt}}" }],
            "url": {
              "raw": "https://merp.intermesh.net/go/api/csd/v1/qualityScoreDetails?glid={{glid}}&empid={{empid}}&limit=20&offset=0",
              "protocol": "https",
              "host": ["merp", "intermesh", "net"],
              "path": ["go", "api", "csd", "v1", "qualityScoreDetails"],
              "query": [
                { "key": "glid", "value": "{{glid}}" },
                { "key": "empid", "value": "{{empid}}" },
                { "key": "limit", "value": "20" },
                { "key": "offset", "value": "0" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Transcripts",
      "item": [
        {
          "name": "transcript (one c2cid per call)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt}}" }],
            "url": {
              "raw": "https://merp.intermesh.net/go/api/genericMod/v1/calltranscriptread?empid={{empid}}&c2cid={{c2cid}}&modid=VoiceAI&screen_name=VoiceAI",
              "protocol": "https",
              "host": ["merp", "intermesh", "net"],
              "path": ["go", "api", "genericMod", "v1", "calltranscriptread"],
              "query": [
                { "key": "empid", "value": "{{empid}}" },
                { "key": "c2cid", "value": "{{c2cid}}" },
                { "key": "modid", "value": "VoiceAI" },
                { "key": "screen_name", "value": "VoiceAI" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Ingestion API",
      "description": "Per-seller ingestion service. Auth: x-api-key. Base URL: {{ingestion_url}}. Soft-404 (returns null) is expected on composite/calls/hotleads/activity when a GLID is missing from seller_profile.",
      "item": [
        {
          "name": "composite",
          "request": {
            "method": "GET",
            "header": [
              { "key": "accept", "value": "application/json" },
              { "key": "x-api-key", "value": "{{ingestion_api_key}}" }
            ],
            "url": {
              "raw": "{{ingestion_url}}/api/v1/sellers/{{glid}}",
              "host": ["{{ingestion_url}}"],
              "path": ["api", "v1", "sellers", "{{glid}}"]
            }
          }
        },
        {
          "name": "calls",
          "request": {
            "method": "GET",
            "header": [
              { "key": "accept", "value": "application/json" },
              { "key": "x-api-key", "value": "{{ingestion_api_key}}" }
            ],
            "url": {
              "raw": "{{ingestion_url}}/api/v1/sellers/{{glid}}/calls",
              "host": ["{{ingestion_url}}"],
              "path": ["api", "v1", "sellers", "{{glid}}", "calls"]
            }
          }
        },
        {
          "name": "hotleads",
          "request": {
            "method": "GET",
            "header": [
              { "key": "accept", "value": "application/json" },
              { "key": "x-api-key", "value": "{{ingestion_api_key}}" }
            ],
            "url": {
              "raw": "{{ingestion_url}}/api/v1/sellers/{{glid}}/hotleads",
              "host": ["{{ingestion_url}}"],
              "path": ["api", "v1", "sellers", "{{glid}}", "hotleads"]
            }
          }
        },
        {
          "name": "blni",
          "request": {
            "method": "GET",
            "header": [
              { "key": "accept", "value": "application/json" },
              { "key": "x-api-key", "value": "{{ingestion_api_key}}" }
            ],
            "url": {
              "raw": "{{ingestion_url}}/api/v1/sellers/{{glid}}/blni",
              "host": ["{{ingestion_url}}"],
              "path": ["api", "v1", "sellers", "{{glid}}", "blni"]
            }
          }
        },
        {
          "name": "metrics",
          "request": {
            "method": "GET",
            "header": [
              { "key": "accept", "value": "application/json" },
              { "key": "x-api-key", "value": "{{ingestion_api_key}}" }
            ],
            "url": {
              "raw": "{{ingestion_url}}/api/v1/sellers/{{glid}}/metrics?as_of={{as_of}}",
              "host": ["{{ingestion_url}}"],
              "path": ["api", "v1", "sellers", "{{glid}}", "metrics"],
              "query": [{ "key": "as_of", "value": "{{as_of}}" }]
            }
          }
        },
        {
          "name": "activity (CSL clickstream — 30d)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "accept", "value": "application/json" },
              { "key": "x-api-key", "value": "{{ingestion_api_key}}" }
            ],
            "url": {
              "raw": "{{ingestion_url}}/api/v1/sellers/{{glid}}/activity",
              "host": ["{{ingestion_url}}"],
              "path": ["api", "v1", "sellers", "{{glid}}", "activity"]
            }
          }
        }
      ]
    },
    {
      "name": "Context API",
      "description": "Two-step UUID flow. Run 'generateContextUID' first, copy data.mapping_id into the {{mapping_id}} collection variable, then run 'getContext'. UUID expires in ~15 min.",
      "item": [
        {
          "name": "Step 1 — generateContextUID",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"mapping_type\":1,\"mapping_value\":\"{{glid}}\",\"source_id\":1,\"empid\":{{empid}},\"ak\":\"{{jwt}}\",\"data_segments\":\"all\"}"
            },
            "url": {
              "raw": "https://merp.intermesh.net/go/api/globalcontext/v1/generateContextUID",
              "protocol": "https",
              "host": ["merp", "intermesh", "net"],
              "path": ["go", "api", "globalcontext", "v1", "generateContextUID"]
            }
          }
        },
        {
          "name": "Step 2 — getContext (no auth — UUID is the credential)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://merp.intermesh.net/go/api/globalcontext/v1/x/getContext?mapping_id={{mapping_id}}&data_keys=all",
              "protocol": "https",
              "host": ["merp", "intermesh", "net"],
              "path": ["go", "api", "globalcontext", "v1", "x", "getContext"],
              "query": [
                { "key": "mapping_id", "value": "{{mapping_id}}" },
                { "key": "data_keys", "value": "all" }
              ]
            }
          }
        }
      ]
    }
  ]
}
