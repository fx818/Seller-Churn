    {
      "name": "Context API",
      "item": [
        {
          "name": "Step 1 — generateContextUID",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"mapping_type\":1,\"mapping_value\":\"{{glid}}\",\"source_id\":1,\"empid\":{{empid}},\"ak\":\"{{jwt}}\",\"data_segments\":\"all\"}"
            },
            "url": {
              "raw": "https://merp.intermesh.net/go/api/globalcontext/v1/generateContextUID",
              "protocol": "https",
              "host": [
                "merp",
                "intermesh",
                "net"
              ],
              "path": [
                "go",
                "api",
                "globalcontext",
                "v1",
                "generateContextUID"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Step 2 — getContext (no auth — UUID is the credential)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://merp.intermesh.net/go/api/globalcontext/v1/x/getContext?mapping_id={{mapping_id}}&data_keys=all",
              "protocol": "https",
              "host": [
                "merp",
                "intermesh",
                "net"
              ],
              "path": [
                "go",
                "api",
                "globalcontext",
                "v1",
                "x",
                "getContext"
              ],
              "query": [
                {
                  "key": "mapping_id",
                  "value": "{{mapping_id}}"
                },
                {
                  "key": "data_keys",
                  "value": "all"
                }
              ]
            }
          },
          "response": []
        }
      ],
      "description": "Two-step UUID flow. Run 'generateContextUID' first, copy data.mapping_id into the {{mapping_id}} collection variable, then run 'getContext'. UUID expires in ~15 min."
    }
  ],
